{
  "_comentario": [
    "ARCHIVO OPCIONAL. No hace falta para que el script funcione: Apps Script calcula",
    "los permisos solo al pegar Code.gs. Esto sirve únicamente si quieres fijarlos a mano.",
    "Para verlo en el editor: Configuracion del proyecto -> marcar",
    "'Mostrar el archivo de manifiesto appsscript.json en el editor'. El archivo debe",
    "llamarse appsscript.json y estar en la raiz del proyecto (no dentro de una carpeta).",
    "Si lo pegas mal, el despliegue falla: si no estas seguro, dejalo como esta (sin manifiesto)."
  ],
  "timeZone": "America/Guayaquil",
  "dependencies": {},
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "webapp": {
    "executeAs": "USER_DEPLOYING",
    "access": "ANYONE_ANONYMOUS"
  },
  "oauthScopes": [
    "https://www.googleapis.com/auth/drive",
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/userinfo.email"
  ]
}
